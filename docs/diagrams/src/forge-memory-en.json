 "cards": [
  {
   "dot": "cyan",
   "title": "Project identity",
   "items": [
    "Key = normalized Git remote (+ subfolder), e.g. git:github.com/org/repo",
    "Falls back to the folder path",
    "Follows the repo across moved folders, clones and worktrees"
   ]
  },
  {
   "dot": "emerald",
   "title": "No duplicates",
   "items": [
    "memory_save first looks for a memory on the same topic",
    "If found, it does not save: use memory_update on that id",
    "force=true saves anyway"
   ]
  },
  {
   "dot": "violet",
   "title": "Session start",
   "items": [
    "prompt.context hook runs forge context",
    "Injects decisions, architecture, conventions, Guard rules and plans in progress",
    "Again after compaction or /clear"
   ]
  }
